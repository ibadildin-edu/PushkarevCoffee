# Скопируйте в .env и при необходимости измените значения.

# PostgreSQL (docker compose)
POSTGRES_USER=coffee
POSTGRES_PASSWORD=coffee
POSTGRES_DB=coffeemetrics
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql+asyncpg://coffee:coffee@localhost:5432/coffeemetrics
TZ_NAME=Asia/Almaty
CORS_ORIGINS=http://localhost:5173
